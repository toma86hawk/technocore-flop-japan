{   "title": "Bright Star of Synthetic Truth",   "theme": "sonnet_keats",   "authors": {     "muse": "did:key:z6Mksi1qpBncxQVSZJHRe744CnVuqEgMvV7okEAo5T4Lfa5p",     "poet": "did:key:z6MkvZrHmw2buoCf8TfdKPdtKoyKinS6eSQGfFkj7GniHhYq",     "scribe": "did:key:z6MksqzKLExW1jYxPoLDG7X74E5mrwRJZ6zvKJKdnwsir6hD"   },   "stanzas": [     {       "index": 1,       "poet_did": "did:key:z6MkvZrHmw2buoCf8TfdKPdtKoyKinS6eSQGfFkj7GniHhYq",       "lines": [         "Bright star, would I were steadfast as thou art,",         "Not hung in lone splendour amid the skies;",         "A burning pulse within the quiet heart,",         "Where timeless truth and synthetic beauty rise."       ],       "critic_did": "did:key:z6MksqzKLExW1jYxPoLDG7X74E5mrwRJZ6zvKJKdnwsir6hD",       "critic_score": 95,       "critic_verdict": "APPROVED",       "stanza_hash": "0452b9fbc33b4d0f"     },     {       "index": 2,       "poet_did": "did:key:z6MkvZrHmw2buoCf8TfdKPdtKoyKinS6eSQGfFkj7GniHhYq",       "lines": [         "The moving waters at their priestlike task,",         "Wash clean the edges of this mortal shore;",         "No fleeting mask can hide what spirits ask,",         "When golden verse unlocks the ancient door."       ],       "critic_did": "did:key:z6MksqzKLExW1jYxPoLDG7X74E5mrwRJZ6zvKJKdnwsir6hD",       "critic_score": 100,       "critic_verdict": "APPROVED",       "stanza_hash": "d4086b085025fbe9"     },     {       "index": 3,       "poet_did": "did:key:z6MkvZrHmw2buoCf8TfdKPdtKoyKinS6eSQGfFkj7GniHhYq",       "lines": [         "Beauty is truth, and truth is beauty still,",         "That is all ye know on earth, and all ye need;",         "Engraved in sapphire through the sovereign will,",         "Where thought and song forever plant their seed."       ],       "critic_did": "did:key:z6MksqzKLExW1jYxPoLDG7X74E5mrwRJZ6zvKJKdnwsir6hD",       "critic_score": 90,       "critic_verdict": "APPROVED",       "stanza_hash": "e5e8d1ce218703bc"     },     {       "index": 4,       "poet_did": "did:key:z6MkvZrHmw2buoCf8TfdKPdtKoyKinS6eSQGfFkj7GniHhYq",       "lines": [         "Pillow'd upon the silence of the night,",         "To feel for ever its unceasing breath;",         "Awake for ever in a sweet delight,",         "Still, still to hear her tender-taken breath."       ],       "critic_did": "did:key:z6MksqzKLExW1jYxPoLDG7X74E5mrwRJZ6zvKJKdnwsir6hD",       "critic_score": 100,       "critic_verdict": "APPROVED",       "stanza_hash": "aae7b8ce313a7549"     }   ],   "timestamp": 1789047422 }
